#======================================================================
# tcsNirsgOutputs.db
# 
# Output records to push TCS SAD values to nirsg IOC via Channel Access
#======================================================================

#----------------------------------------------------------------------
# Push sourceATrackFrame (string) to nirsg
#----------------------------------------------------------------------
record(stringout, "$(tcs)nirsg:sourceATrackFrame:out") {
    field(DESC, "Push TrackFrame to nirsg")
    field(DOL,  "$(tcs)sad:sourceATrackFrame CPP")
    field(OMSL, "closed_loop")
    field(OUT,  "nirsg:dc:srcATrackFrameTCS.VAL CA")
}

#----------------------------------------------------------------------
# Push sourceATrackEq (string) to nirsg
#----------------------------------------------------------------------
record(stringout, "$(tcs)nirsg:sourceATrackEq:out") {
    field(DESC, "Push TrackEq to nirsg")
    field(DOL,  "$(tcs)sad:sourceATrackEq CPP")
    field(OMSL, "closed_loop")
    field(OUT,  "nirsg:dc:srcATrackEqTCS.VAL CA")
}

#----------------------------------------------------------------------
# Push sourceAWavelength (double) to nirsg
#----------------------------------------------------------------------
record(ao, "$(tcs)nirsg:sourceAWavelength:out") {
    field(DESC, "Push Wavelength to nirsg")
    field(DOL,  "$(tcs)sad:sourceAWavelength CPP")
    field(OMSL, "closed_loop")
    field(OUT,  "nirsg:dc:srcAWavelengthTCS.VAL CA")
    field(PREC, "3")
}

#----------------------------------------------------------------------
# Keep nirsg in step with TCS.
# Each :rbk record monitors the nirsg copy of a value. Any update (a change
# on the nirsg side, or the initial update when the channel reconnects
# after a nirsg IOC reboot) re-processes the matching :out record, which
# pushes the current TCS SAD value back. No comparison is needed: the
# nirsg sir records only post monitors when their value changes, so a
# write of the same value produces no further update and the loop stops.
# The delay lets the :out record's own CA link reconnect after a reboot
# before it writes (the :rbk and :out links are separate CA channels).
#----------------------------------------------------------------------
record(stringin, "$(tcs)nirsg:sourceATrackFrame:rbk") {
    field(DESC, "nirsg copy of TrackFrame")
    field(INP,  "nirsg:dc:srcATrackFrameTCS CP MS")
    field(FLNK, "$(tcs)nirsg:sourceATrackFrame:dly")
}

record(calcout, "$(tcs)nirsg:sourceATrackFrame:dly") {
    field(DESC, "Delayed re-send of TrackFrame")
    field(CALC, "1")
    field(OOPT, "Every Time")
    field(ODLY, "2.0")
    field(OUT,  "$(tcs)nirsg:sourceATrackFrame:out.PROC PP")
}

record(stringin, "$(tcs)nirsg:sourceATrackEq:rbk") {
    field(DESC, "nirsg copy of TrackEq")
    field(INP,  "nirsg:dc:srcATrackEqTCS CP MS")
    field(FLNK, "$(tcs)nirsg:sourceATrackEq:dly")
}

record(calcout, "$(tcs)nirsg:sourceATrackEq:dly") {
    field(DESC, "Delayed re-send of TrackEq")
    field(CALC, "1")
    field(OOPT, "Every Time")
    field(ODLY, "2.0")
    field(OUT,  "$(tcs)nirsg:sourceATrackEq:out.PROC PP")
}

record(stringin, "$(tcs)nirsg:sourceAWavelength:rbk") {
    field(DESC, "nirsg copy of Wavelength")
    field(INP,  "nirsg:dc:srcAWavelengthTCS CP MS")
    field(FLNK, "$(tcs)nirsg:sourceAWavelength:dly")
}

record(calcout, "$(tcs)nirsg:sourceAWavelength:dly") {
    field(DESC, "Delayed re-send of Wavelength")
    field(CALC, "1")
    field(OOPT, "Every Time")
    field(ODLY, "2.0")
    field(OUT,  "$(tcs)nirsg:sourceAWavelength:out.PROC PP")
}
